# Resend API key from https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key
# Use a verified sending domain before production
EMAIL_FROM=Collably <no-reply@your-verified-domain.com>
FRONTEND_URL=http://localhost:5173
COLLABLY_SECRET=replace-with-a-long-random-secret
# DATABASE_URL defaults to local SQLite. Set it to your Neon PostgreSQL URL on Vercel.
